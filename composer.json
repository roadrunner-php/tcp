{
    "name": "roadrunner/tcp",
    "type": "library",
    "description": "PHP worker for the RoadRunner TCP plugin: handle raw TCP connection events and data in RoadRunner workers",
    "keywords": [
        "roadrunner",
        "tcp",
        "socket",
        "server",
        "worker"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Anton Titov",
            "homepage": "https://github.com/wolfy-j"
        },
        {
            "name": "Pavel Buchnev",
            "homepage": "https://github.com/butschster"
        },
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Maksim Smakouz",
            "homepage": "https://github.com/msmakouz"
        },
        {
            "name": "RoadRunner Community",
            "homepage": "https://github.com/roadrunner-server/roadrunner/graphs/contributors"
        }
    ],
    "homepage": "https://roadrunner.dev/",
    "support": {
        "docs": "https://docs.roadrunner.dev/docs/plugins/tcp",
        "issues": "https://github.com/roadrunner-server/roadrunner/issues",
        "source": "https://github.com/roadrunner-php/tcp",
        "forum": "https://forum.roadrunner.dev/",
        "chat": "https://discord.gg/V6EK4he"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/roadrunner-server"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "roadrunner/worker": "^3.8",
        "spiral/roadrunner": "^3.0"
    },
    "require-dev": {
        "jetbrains/phpstorm-attributes": "^1.0",
        "mockery/mockery": "^1.6",
        "spiral/code-style": "^2.3.1",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "replace": {
        "spiral/roadrunner-tcp": "self.version"
    },
    "suggest": {
        "roadrunner/cli": "Provides RoadRunner installation and management CLI tools"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\RoadRunner\\Tcp\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\RoadRunner\\Tcp\\Tests\\": "tests"
        }
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "tests": "@test",
        "psalm": "psalm",
        "test": "vendor/bin/testo",
        "test:unit": "vendor/bin/testo --suite=Unit"
    },
    "config": {
        "audit": {
            "ignore": {
                "GHSA-g9pc-8g42-g6vq": "False positive: the range < 2025.1.0 also matches RoadRunner 3.x, which is not affected"
            }
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
